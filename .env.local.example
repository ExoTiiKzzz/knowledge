# Local development only. `npx convex dev` writes these three — do not fill them by
# hand, and never commit .env.local.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Nothing else belongs here. The Google credentials are read by the Convex runtime,
# not by Next, so they go on the deployment instead:
#
#   npx convex env set AUTH_GOOGLE_ID     <client-id>
#   npx convex env set AUTH_GOOGLE_SECRET <client-secret>
#
# See the Deploying section of CLAUDE.md for the full list and where each one lives.
